# ---------------------------------------------------------------------------
# RepoLens – environment variable placeholders
# Populate these in a local .env.local file (which is gitignored).
# Do NOT commit real secrets.
# ---------------------------------------------------------------------------

# GitHub API token (used in Phase 2+ to fetch repository contents)
GITHUB_TOKEN=

# Paritok API credentials (used in Phase 2+ for token optimization)
PARITOK_API_KEY=
PARITOK_API_URL=

# OpenAI API key (used in Phase 3+ for AI-generated answers)
OPENAI_API_KEY=

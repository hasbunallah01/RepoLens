# ---------------------------------------------------------------------------
# RepoLens – environment variable placeholders
#
# Copy this file to `.env.local` (which is gitignored) and fill in the
# values before running `npm run dev` or deploying.
#
# NEVER commit a real secret. The authoritative list of variables is
# defined in `lib/config/`; this file mirrors that list with placeholder
# values for human reference.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Required — the application will not start without these.
# ---------------------------------------------------------------------------

# OpenAI API key (used in Phase 3+ for AI-generated answers).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Paritok API key (used in Phase 2+ for token optimization).
# Get one from your Paritok dashboard.
PARITOK_API_KEY=

# ---------------------------------------------------------------------------
# Optional — sensible defaults are used when these are unset.
# ---------------------------------------------------------------------------

# Override the Paritok compression endpoint. Leave empty to use the
# public default (https://www.paritok.com/api/compress). Only set this
# for staging or self-hosted Paritok instances.
PARITOK_API_URL=

# GitHub API token (used in Phase 2+ to fetch repository contents).
# Strongly recommended for any non-toy deployment: without a token the
# public rate limit is 60 requests / hour per IP. A classic PAT with
# `public_repo` scope is sufficient. Get one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=
